# Copy to .env for local development (.env is git-ignored). Never commit real values.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info

# Platform tables (pms.sys_*). Locally: the docker-compose Postgres 11.
CONTROL_DATABASE_URL=postgres://pms:pms@localhost:5433/esispms?sslmode=disable

# db_key -> database URL, as JSON. Each tenant row points at one key.
TENANT_DATABASES={"esis":"postgres://pms:pms@localhost:5433/esispms?sslmode=disable"}

DEFAULT_TIMEZONE=Asia/Kolkata
# How many financial years after the current one may be created (0-5).
FY_FUTURE_YEARS=1

# Generate each with: openssl rand -base64 48   (they must differ, 32+ chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=pms-api
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxy CIDRs whose X-Forwarded-For is trusted for the client IP; leave empty when clients connect directly.
TRUSTED_PROXIES=
REQUEST_TIMEOUT=15s
LOGIN_RATE_LIMIT_PER_MINUTE=10
